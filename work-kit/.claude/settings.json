{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/credentials*.json)",
      "Read(./**/token*.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/sessionstart_catchup.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/sessionstart_catchup.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_milestone_check.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_milestone_check.py\" 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
